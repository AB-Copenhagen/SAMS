generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Asset {
  id                 String      @id @default(cuid())
  title              String?
  description        String?
  shareText          String?
  eventName          String?
  eventDate          DateTime?
  location           String?
  objectKey          String      @unique
  contentHash        String?     @unique
  aiTagStatus        String      @default("pending")
  assetUrl           String
  fileType           String
  fileSize           Int
  uploaderEmail      String
  uploaderRole       String
  manualTagsJson     String?
  detectedTagsJson   String?
  wasbaiResponseJson String?
  gcvResponseJson    String?
  aiDescription      String?
  uploadedAt         DateTime    @default(now())
  category           String?
  exifJson           String?
  collectionId       String?
  collection         Collection? @relation(fields: [collectionId], references: [id])
  seasonId           String?
  season             Season?     @relation(fields: [seasonId], references: [id])
  ingestJob          IngestJob?
  faceTagStatus      String      @default("pending")
  faceTagAttempts    Int         @default(0)
  thumbnailKey       String?
  thumbnailStatus    String      @default("pending")
  thumbnailAttempts  Int         @default(0)
  durationMs         Int?
  videoWidth         Int?
  videoHeight        Int?
  rating             Int?
  reviewedAt         DateTime?
  reviewedBy         String?
  editedKey          String?
  editParamsJson     String?
  webPreviewKey      String?
  isPublic           Boolean     @default(false)
  shareToken         String?     @unique
  shareUpdatedAt     DateTime?
  expiresAt          DateTime?
  importSource       String?
  legacyMetaJson     String?
  playerTags         AssetPlayerTag[]
  sponsorTags        AssetSponsorTag[]
  collectionMemberships CollectionAsset[]

  @@index([uploadedAt])
  @@index([seasonId, uploadedAt])
  @@index([collectionId])
  @@index([category])
  @@index([importSource])
  @@index([faceTagStatus, uploadedAt])
  @@index([thumbnailStatus, uploadedAt])
  @@index([reviewedAt, faceTagStatus])
}

model AssetPlayerTag {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  source     String
  confidence Float?
  status     String    @default("suggested")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@unique([assetId, playerId, source])
  @@index([playerId, status])
}

model AssetSponsorTag {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  sponsorId  String
  sponsor    Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  source     String
  confidence Float?
  status     String    @default("suggested")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@unique([assetId, sponsorId, source])
  @@index([sponsorId, status])
}

model DeviceCredential {
  id         String      @id @default(cuid())
  name       String
  keyPrefix  String      @unique
  keyHash    String
  ownerEmail String
  role       String      @default("MEDIA")
  scopesJson String      @default("[\"ingest:write\"]")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())
  ingestJobs IngestJob[]
}

model IngestJob {
  id             String            @id @default(cuid())
  deviceId       String?
  device         DeviceCredential? @relation(fields: [deviceId], references: [id])
  uploaderEmail  String
  uploaderRole   String
  channel        String
  fileName       String
  fileType       String
  fileSize       Int
  contentHash    String?
  objectKey      String            @unique
  uploadId       String?
  partSize       Int?
  partsTotal     Int?
  partsCompleted Int               @default(0)
  status         String            @default("pending")
  errorMessage   String?
  assetId        String?           @unique
  asset          Asset?            @relation(fields: [assetId], references: [id])
  metadataJson   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  @@index([status, updatedAt])
  @@index([uploaderEmail, updatedAt])
  @@index([deviceId, updatedAt])
}

model ShareEvent {
  id           String   @id @default(cuid())
  kind         String   // "view" | "download"
  token        String
  collectionId String?
  assetId      String?
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
  @@index([kind, collectionId])
  @@index([kind, assetId])
}

model CronRun {
  id                 String    @id @default(cuid())
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
  durationMs         Int?
  status             String    @default("running") // running | success | error
  errorMessage       String?
  facesDone          Int       @default(0)
  facesSkipped       Int       @default(0)
  facesFailed        Int       @default(0)
  facesStillPending  Int       @default(0)
  thumbsDone         Int       @default(0)
  thumbsSkipped      Int       @default(0)
  thumbsFailed       Int       @default(0)
  thumbsStillPending Int       @default(0)
  uploadsAborted     Int       @default(0)

  @@index([startedAt])
}

model Season {
  id          String       @id @default(cuid())
  name        String
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  assets      Asset[]
  collections Collection[]
  players     Player[]
}

model Player {
  id                String           @id @default(cuid())
  name              String
  number            Int?
  position          String?
  headshotUrl       String?
  active            Boolean          @default(true)
  team              String?
  seasonId          String?
  season            Season?          @relation(fields: [seasonId], references: [id])
  createdAt         DateTime         @default(now())
  faceEnrolledAt    DateTime?
  rekognitionFaceId String?
  // ab.dk's squad page embeds this as the numeric filename in each player's data-si-fallback
  // image URL (Sport-IT, their squad-data vendor) — a stable per-player ID, unlike their printed
  // name, which the CMS doesn't encode consistently across scrapes. Source of truth for matching
  // a scraped player back to their existing record.
  siPlayerId        String?          @unique
  assetTags         AssetPlayerTag[]
  collectionRules   CollectionPlayerRule[]
}

model Sponsor {
  id          String            @id @default(cuid())
  name        String
  logoUrl     String?
  tier        String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  aliasesJson String?
  assetTags   AssetSponsorTag[]
  collectionRules CollectionSponsorRule[]
}

model Stadium {
  id          String       @id @default(cuid())
  name        String
  city        String?
  createdAt   DateTime     @default(now())
  collections Collection[]
}

model Collection {
  id                String    @id @default(cuid())
  name              String
  type              String    @default("game")
  date              DateTime?
  opponent          String?
  venue             String?
  coverUrl          String?
  createdAt         DateTime  @default(now())
  seasonId          String?
  season            Season?   @relation(fields: [seasonId], references: [id])
  stadiumId         String?
  stadium           Stadium?  @relation(fields: [stadiumId], references: [id])
  assets            Asset[]
  isPublic          Boolean   @default(false)
  shareToken        String?   @unique
  sharePasswordSalt String?
  sharePasswordHash String?
  shareUpdatedAt    DateTime?
  shareMinRating    Int?
  shareDateRangeDays Int?
  expiresAt         DateTime?
  manualAssets      CollectionAsset[]
  playerRules       CollectionPlayerRule[]
  sponsorRules      CollectionSponsorRule[]
}

model CollectionAsset {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())
  addedBy      String?

  @@unique([collectionId, assetId])
  @@index([assetId])
}

model CollectionPlayerRule {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([collectionId, playerId])
}

model CollectionSponsorRule {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  sponsorId    String
  sponsor      Sponsor    @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([collectionId, sponsorId])
}

model Customer {
  // The Descope internal userId from the consumer-facing "MyAB" project — stable across
  // Descope, Goliath (which logs users in through Descope, so its externalId is this same
  // value) and, once matched by email, Shopify. See lib/descope-customers.ts.
  id                   String    @id
  email                String?
  name                 String?
  phone                String?
  marketingOptIn       Boolean?
  descopeCreatedAt     DateTime?
  descopeSyncedAt      DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  lastLoginCountry     String?
  goliathUserId        String?
  goliathSegmentsJson  String?
  goliathSyncedAt      DateTime?
  shopifyCustomerId    String?
  shopifyLifetimeSpend Float?
  shopifyOrderCount    Int?
  shopifyLastOrderAt   DateTime?
  shopifySyncedAt      DateTime?
  mailerliteSubscriberId String?
  mailerliteStatus       String?   // "active" | "unsubscribed" | "unconfirmed" | "bounced" | "junk"
  mailerliteGroupsJson   String?   // flat JSON array of group names, same shape as goliathSegmentsJson
  mailerliteSentCount    Int?
  mailerliteOpensCount   Int?
  mailerliteOpenRate     Float?    // 0-1
  mailerliteSyncedAt     DateTime?
  // Sourced from Descope's "eventbillettenUuid" custom attribute (confirmed live) — this IS
  // Vivenu's own Customer._id, so every Vivenu call is a direct lookup, never an email search.
  vivenuCustomerId            String?
  vivenuLifetimeSpend         Float?
  vivenuSeasonPassStatus      String?   // the GROUP event's name (e.g. "Sæsonkort 2026/27"), or null
  vivenuMatchesPurchasedCount Int?      // recomputed in full on every refresh from transaction history
  // The SINGLE-type event IDs backing vivenuMatchesPurchasedCount, kept (not just the count) so
  // the customer detail page can list which matches were purchased, same shape/purpose as
  // vivenuAttendedEventIdsJson below. Recomputed in full on every refresh, same as the count.
  vivenuPurchasedEventIdsJson String?
  // Accrues via the scan.created webhook, which is the only realistic source for this (Vivenu's
  // Scans API has no customerId filter — see lib/vivenu.ts) — not re-derivable from a fresh pull,
  // so the actual event-id set is kept (for dedup against repeat webhook deliveries) alongside
  // the count lib/customer-ui.ts/pages read.
  vivenuAttendedEventIdsJson  String?
  vivenuMatchesAttendedCount  Int?
  vivenuSyncedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([email])
  @@index([shopifyLifetimeSpend])
}

model CustomerSyncRun {
  id           String    @id @default(cuid())
  source       String    // "descope" | "goliath" | "shopify"
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    @default("running") // running | success | error
  processed    Int       @default(0)
  errorMessage String?

  @@index([source, startedAt])
}

// Per-admin-staff display preferences. id = the signed-session user id (Descope user id) — no
// FK, since staff identity lives entirely in Descope/the session cookie (see lib/auth.ts),
// not a local User table.
model StaffPreference {
  id                 String   @id
  theme              String?  // "light" | "dark" | null (= browser/system default)
  defaultPageSize    Int?
  defaultLandingPage String?
  updatedAt          DateTime @updatedAt
}

// A real chronological event log for a Customer, written by the sync crons/jobs as they detect
// an actual change (not a snapshot of current state, which the Customer row already holds).
// Standalone like CustomerSyncRun above — no @relation back to Customer, same precedent.
model CustomerActivity {
  id         String   @id @default(cuid())
  customerId String
  type       String   // "login" | "consent_changed" | "segments_changed" | "order_placed" | "match_attended"
  occurredAt DateTime
  detail     String?
  createdAt  DateTime @default(now())

  // Lets every writer use createMany({ skipDuplicates: true }) (or a plain create()) without
  // double-logging on a re-run or an overlapping sync window.
  @@unique([customerId, type, occurredAt])
  @@index([customerId, occurredAt])
}

// Cache of Vivenu Event._id -> eventType (SINGLE vs GROUP, see lib/vivenu.ts), so classifying a
// customer's transaction history as season-pass-vs-single-match doesn't mean one Vivenu API call
// per distinct event per customer enrichment — a club's event count is small and stable within a
// season, so this is reused across every customer instead.
model VivenuEvent {
  id        String   @id // Vivenu's own Event._id
  name      String?
  eventType String   // "SINGLE" | "GROUP" | "RECURRENCE" | "ROOT"
  syncedAt  DateTime @default(now())
}

// Generic small key-value store for cron resume cursors — currently just
// "descope-customers-resume-page" (see app/api/cron/sync-customers), but deliberately not
// named for that one case, since any cron that can't finish a full sweep in one invocation
// needs the same mechanism.
model SyncState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
